---
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../data/site.json';
import about from '../data/about.json';

const waText = encodeURIComponent('您好，我想了解裕明兴的工厂与产品。');
const waLink = `https://wa.me/${site.contact.whatsappDigits}?text=${waText}`;
---
<BaseLayout
  title="关于我们"
  description={`关于${site.companyName}：${site.description}`}
>
  <!-- Hero -->
  <section class="brand-hero text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-20 md:py-24">
      <nav class="text-sm text-white/60 mb-5">
        <a href="/" class="hover:text-white">首页</a> <span class="mx-1">/</span> <span class="text-white">关于我们</span>
      </nav>
      <p class="reveal eyebrow eyebrow-amber">{about.hero.eyebrow}</p>
      <h1 class="reveal reveal-d1 steel-text font-display font-extrabold text-4xl md:text-5xl mt-2 max-w-3xl leading-tight">{about.hero.title}</h1>
      <p class="reveal reveal-d2 mt-5 text-lg text-white/75 max-w-2xl leading-relaxed">{about.hero.subtitle}</p>
    </div>
  </section>

  <!-- Stats -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 -mt-10 relative z-10">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-px bg-line rounded-2xl overflow-hidden border border-line shadow-[var(--shadow-soft)]">
      {about.stats.map((s, i) => (
        <div class={`reveal reveal-d${i + 1} card-hover bg-white px-6 py-7 text-center`}>
          <div class="font-display font-extrabold text-3xl brand-gradient-text">{s.value}</div>
          <div class="text-ink-muted text-sm mt-1">{s.label}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- Story -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-16 sm:py-20 grid lg:grid-cols-2 gap-12 items-center">
    <div class="reveal rounded-3xl overflow-hidden aspect-[4/3] border border-line ring-1 ring-line">
      <div class="sheen group w-full h-full">
        <img src={about.story.image} alt={about.story.title} loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
      </div>
    </div>
    <div class="reveal reveal-d1">
      <p class="eyebrow">Our Story</p>
      <h2 class="font-display font-extrabold text-3xl md:text-4xl text-ink mt-2">{about.story.title}</h2>
      <div class="mt-6 space-y-4 text-ink-soft leading-relaxed">
        {about.story.paragraphs.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  <!-- Capabilities -->
  <section class="bg-sand/60 border-y border-line">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-16 sm:py-20">
      <div class="reveal text-center max-w-2xl mx-auto mb-12">
        <p class="eyebrow eyebrow-center justify-center">工厂实力</p>
        <h2 class="font-display font-extrabold text-3xl md:text-4xl text-ink mt-1">从材料到成品的全流程能力</h2>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {about.capabilities.map((c, i) => (
          <div class={`reveal reveal-d${i + 1} card-hover bg-white rounded-2xl border border-line p-6`}>
            <span class="font-display font-extrabold text-2xl brand-gradient-text">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="font-display font-bold text-ink text-lg mt-2">{c.title}</h3>
            <p class="text-ink-muted text-sm mt-2 leading-relaxed">{c.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-16">
    <div class="reveal brand-hero rounded-3xl px-6 sm:px-12 py-14 text-center text-white ring-1 ring-white/10">
      <p class="eyebrow eyebrow-amber eyebrow-center justify-center mb-4">开启合作</p>
      <h2 class="font-display font-extrabold text-3xl md:text-4xl">想参观工厂或获取样品？</h2>
      <p class="mt-4 text-white/75 max-w-xl mx-auto">欢迎随时联系我们，了解更多产品与定制方案。</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href={waLink} target="_blank" rel="noopener" data-wa data-wa-product="about_cta" class="btn btn-primary px-7 py-3.5">WhatsApp 联系</a>
        <a href="/contact" class="btn btn-outline px-7 py-3.5">查看联系方式</a>
      </div>
    </div>
  </section>
</BaseLayout>
